# Use one supported PostgreSQL connection variable.
DATABASE_URL=postgresql://user:password@localhost:5432/atehna

# Optional PostgreSQL runtime controls. Unset values retain node-postgres
# defaults in every environment; enable tighter limits only after measuring
# production-like workloads such as the monthly address index rebuild.
# Use 0 to disable a timeout; pool size must remain between 1 and 50.
# ATEHNA_DB_POOL_MAX=10
# ATEHNA_DB_CONNECTION_TIMEOUT_MS=0
# ATEHNA_DB_IDLE_TIMEOUT_MS=10000
# ATEHNA_DB_STATEMENT_TIMEOUT_MS=0
# ATEHNA_DB_LOCK_TIMEOUT_MS=0

# Database-backed admin account: initialize offline; see docs/admin-auth-setup.md.
# Required server-only secret, at least 32 random characters.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Use the canonical HTTPS application origin in deployed environments.
ADMIN_AUTH_URL=http://localhost:3000
# Username/password and session policy are stored in PostgreSQL, not runtime env.

# Required for scheduled retention and audit cleanup on Vercel.
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters

# Required only when automatic order email is enabled. Store this as a
# Sensitive Vercel environment variable; never expose it to the browser.
RESEND_API_KEY=re_replace-with-your-resend-api-key

# Required for public catalogue and site media. Connect the public Vercel Blob
# store through OIDC; browser uploads are presigned and sent directly to Blob.
PUBLIC_MEDIA_BLOB_STORE_ID=store_replace-with-your-public-store-id

# Required for generated/uploaded order documents. Connect a separate Private
# Vercel Blob store through OIDC and set its store id here.
ORDER_DOCUMENT_BLOB_STORE_ID=store_replace-with-your-private-store-id

# Required for replaying an order submission without storing its bootstrap token
# in plaintext. Keep this stable and use at least 32 random characters.
ORDER_ACCESS_BOOTSTRAP_KEY=replace-with-a-random-order-bootstrap-key-at-least-32-characters

# Required for replaying quote requests/responses without storing access
# bootstraps in plaintext. Keep it stable, separate from the order key, and use
# at least 32 random characters. Quote crypto uses its own KDF/AAD domain.
QUOTE_ACCESS_BOOTSTRAP_KEY=replace-with-a-random-quote-bootstrap-key-at-least-32-characters

# Optional fallback for catalogue rows without a product tax rate.
ORDER_DEFAULT_TAX_RATE=0.22

# Quote workflow rollout gates. Keep every flag disabled until the complete
# canonical fresh schema and intended environment are verified. Enable in this order:
# admin tooling, public requests, then customer acceptance. Business email
# delivery is controlled by the persisted toggles under Admin > Email and is
# off by default. The quote-email toggle also controls OTP security messages,
# so enable it before enabling online acceptance.
QUOTE_ADMIN_ENABLED=false
QUOTE_PUBLIC_REQUESTS_ENABLED=false
QUOTE_ONLINE_ACCEPTANCE_ENABLED=false
