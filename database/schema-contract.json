    "constraints": [
      {
        "table": "inventory_policy_settings",
        "name": "inventory_policy_settings_config_json_check",
        "type": "check",
        "definitionEquals": "CHECK (jsonb_typeof(config_json) = 'object'::text AND config_json ? 'stockEnforcementEnabled'::text AND jsonb_typeof(config_json -> 'stockEnforcementEnabled'::text) = 'boolean'::text)",
        "definitionIncludes": [
          "stockEnforcementEnabled",
          "jsonb_typeof",
          "boolean"
        ]
      },
      {
        "table": "orders",
        "name": "orders_contract_status_check",
        "type": "check",
        "definitionEquals": "CHECK (contract_status = ANY (ARRAY['pending_seller_acceptance'::text, 'accepted'::text, 'rejected'::text]))",
        "definitionIncludes": [
          "pending_seller_acceptance",
          "accepted",
          "rejected"
        ]
      },
      {
        "table": "orders",
        "name": "orders_delivery_plan_revision_positive_check",
        "type": "check",
        "definitionEquals": "CHECK (delivery_plan_revision > 0)",
        "definitionIncludes": [
          "delivery_plan_revision"
        ]
      },
      {
        "table": "orders",
        "name": "orders_public_code_base_check",
        "type": "check",
        "definitionEquals": "CHECK (public_code_base ~ '^[23456789ABCDEFGHJKMNPQRSTVWXYZ]{16}$'::text)",
        "definitionIncludes": [
          "public_code_base",
          "23456789ABCDEFGHJKMNPQRSTVWXYZ",
          "{16}"
        ]
      },
      {
        "table": "order_documents",
        "name": "order_documents_delivery_plan_revision_positive_check",
        "type": "check",
        "definitionEquals": "CHECK (order_delivery_plan_revision > 0)",
        "definitionIncludes": [
          "order_delivery_plan_revision"
        ]
      },
      {
        "table": "quote_email_jobs",
        "name": "quote_email_jobs_cancellation_check",
        "type": "check",
        "definitionEquals": "CHECK (status = 'cancelled'::text AND cancelled_at IS NOT NULL AND cancelled_by_actor_id IS NOT NULL AND btrim(cancelled_by_actor_id) <> ''::text OR status <> 'cancelled'::text AND cancelled_at IS NULL AND cancelled_by_actor_id IS NULL)",
        "definitionIncludes": [
          "cancelled_at",
          "cancelled_by_actor_id"
        ]
      },
      {
        "table": "quote_email_jobs",
        "name": "quote_email_jobs_event_type_check",
        "type": "check",
        "definitionEquals": "CHECK (event_type = ANY (ARRAY['quote_request_submitted'::text, 'quote_clarification_requested'::text, 'quote_issued'::text, 'quote_access_otp'::text, 'quote_accepted'::text, 'quote_declined'::text, 'quote_withdrawn'::text, 'quote_expired'::text, 'quote_request_closed'::text, 'quote_acceptance_blocked_stock'::text, 'quote_delivery_failed'::text]))",
        "definitionIncludes": [
          "quote_clarification_requested"
        ]
      },
      {
        "table": "quote_email_jobs",
        "name": "quote_email_jobs_status_check",
        "type": "check",
        "definitionEquals": "CHECK (status = ANY (ARRAY['pending'::text, 'processing'::text, 'sent'::text, 'failed'::text, 'cancelled'::text]))",
        "definitionIncludes": [
          "cancelled"
        ]
      },
      {
        "table": "quote_events",
        "name": "quote_events_event_type_check",
        "type": "check",
        "definitionEquals": "CHECK (event_type = ANY (ARRAY['request_received'::text, 'quote_request_details_changed'::text, 'draft_created'::text, 'draft_changed'::text, 'clarification_requested'::text, 'preview_generated'::text, 'offer_issued'::text, 'quote_email_queued'::text, 'quote_email_provider_accepted'::text, 'quote_email_provider_failed'::text, 'offer_viewed'::text, 'customer_acceptance_attempted'::text, 'acceptance_blocked_stock'::text, 'customer_accepted'::text, 'customer_declined'::text, 'customer_purchase_order_uploaded'::text, 'admin_document_uploaded'::text, 'admin_purchase_order_validated'::text, 'admin_purchase_order_rejected'::text, 'offer_withdrawn'::text, 'offer_expired'::text, 'offer_superseded'::text, 'new_version_issued'::text, 'request_closed_without_offer'::text, 'request_voided'::text, 'order_created'::text]))",
        "definitionIncludes": [
          "admin_document_uploaded",
          "quote_request_details_changed",
          "request_voided"
        ]
      },
      {
        "table": "quote_manual_documents",
        "name": "quote_manual_documents_offer_request_fkey",
        "type": "foreign_key",
        "definitionEquals": "FOREIGN KEY (quote_offer_version_id, quote_request_id) REFERENCES quote_offer_versions(id, quote_request_id) ON DELETE RESTRICT",
        "definitionIncludes": [
          "quote_offer_versions"
        ]
      },
      {
        "table": "quote_offer_versions",
        "name": "quote_offer_versions_issue_identity_check",
        "type": "check",
        "definitionEquals": "CHECK (status = 'draft'::text AND offer_number IS NULL AND issued_at IS NULL AND issued_by_actor_type IS NULL AND issued_by_actor_id IS NULL AND is_current = false OR status <> 'draft'::text AND offer_number IS NOT NULL AND issued_at IS NOT NULL AND issued_by_actor_type IS NOT NULL AND valid_until IS NOT NULL AND valid_until > issued_at AND customer_snapshot_json <> '{}'::jsonb AND content_snapshot_json <> '{}'::jsonb AND NULLIF(btrim(delivery_terms), ''::text) IS NOT NULL AND NULLIF(btrim(payment_terms), ''::text) IS NOT NULL AND NULLIF(btrim(terms_version), ''::text) IS NOT NULL AND terms_hash IS NOT NULL AND content_hash IS NOT NULL)",
        "definitionIncludes": [
          "terms_version",
          "terms_hash"
        ],
        "definitionExcludes": [
          "terms_text"
        ]
      },
      {
        "table": "quote_requests",
        "name": "quote_requests_admin_title_check",
        "type": "check",
        "definitionEquals": "CHECK (admin_title IS NULL OR NULLIF(btrim(admin_title), ''::text) IS NOT NULL AND char_length(admin_title) <= 240)",
        "definitionIncludes": [
